{
  "name": "@c9up/vellum",
  "version": "0.1.0",
  "description": "PDF toolkit \u2014 convert PDF pages to images, author and inspect documents",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/VellumProvider.ts",
      "import": "./src/VellumProvider.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:napi": "cargo build --release -p vellum-engine-napi && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "test": "vitest run",
    "test:rust": "cargo test",
    "lint": "biome check src/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@c9up/ream": "^0.2.0",
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/VellumProvider.d.ts",
        "import": "./dist/VellumProvider.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/vellum.git"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    }
  }
}
